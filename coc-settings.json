{
  "dart.showTodos": false,
  "dart.enableSdkFormatter": false,
  "flutter.workspaceFolder.ignore": [
      "~/.pub-cache",
      "~/fvm/versions/stable/packages/flutter"
  ],
 "languageserver": {
    "csharp-ls": {
      "command": "csharp-ls",
      "filetypes": ["cs"],
      "rootPatterns": ["*.csproj", ".vim/", ".git/", ".hg/"]
    }
  },
  "dart.analysisExcludedFolders": [
    "~/.pub-cache",
    "~/fvm/versions/stable/"
  ],
  "go.goplsOptions": {
    "completeUnimported": true,
    "hoverKind": "SingleLine",
  },
  "codeLens.enable": true,
  "go.goplsPath": "~/go/bin/gopls",
  "yaml.schemas": {
    "url": "globPattern",
    "Kubernetes": "globPattern"
  },
  "list.source.outline.defaultArgs": [],
  "rust-analyzer.server.path": "~/.cargo/bin/rust-analyzer",
  "notification.disabledProgressSources": [
    "*"
  ],
  "diagnostic.displayByAle": true,
  "coc.preferences.bracketEnterImprove": true,
  "diagnostic.checkCurrentLine": true,
  "diagnostic.virtualText": false,
  "diagnostic.enable": true,
  "suggest.enablePreselect": false,
  "suggest.enableFloat": true,
  "suggest.virtualText": true,
  "suggest.noselect": false,
  "suggest.detailField": "preview",
  "suggest.minTriggerInputLength": 2,
  // override some settings specifically for dart
  "[dart]": {
    "suggest.triggerCompletionWait": 10,
    "suggest.minTriggerInputLength": 3,
    "suggest.timeout": 15000,
  },
  "hover.previewMaxHeight": 10,
  "sql.database": "postgresql",
  "sql.lintOnSave": false,
  "sql.lintOnChange": false,
  "suggest.completionItemKindLabels": {
    "array" : "",
    "boolean" : "",
    "class" : "",
    "color" : "",
    "constant" : "",
    "constructor" : "",
    "enum" : "",
    "enummember" : "",
    "event" : "",
    "field" : "",
    "file" : "",
    "folder" : "󰉋",
    "function" : "",
    "interface" : "",
    "key" : "",
    "keyword" : "",
    "method" : "",
    "module" : "",
    "namespace" : "",
    "null" : "󰟢",
    "number" : "",
    "object" : "",
    "operator" : "",
    "package" : "",
    "property" : "",
    "reference" : "",
    "snippet" : "",
    "string" : "",
    "struct" : "",
    "text" : "",
    "typeParameter" : "",
    "unit" : "",
    "value" : "",
    "variable" : "",
  },
  "hover.floatConfig": {
    "border": true,
    "title": " 🙈",
    "maxHeight": 10,
    "highlight": "CocHintFloat",
    "borderhighlight": "CocFloatDividingLine",
  },
  "suggest.labelMaxLength": 50,
  "suggest.floatConfig": {
    "border": false,
    "highlight": "CocFloating",
    "borderhighlight": "CocFloatDividingLine",
  },
  "signature.floatConfig": {
    "border": true,
    "title": " 🙈",
    "highlight": "CocHintFloat",
    "borderhighlight": "CocFloatDividingLine",
  },
  "suggest.formatItems": [
    "kind",
    "abbr",
    "menu",
    "shortcut"
  ],
  "coc.source.file.shortcut": "F",
  "coc.source.buffer.shortcut": "B",
  "coc.source.around.shortcut": "A",
  "java.format.enabled": true,
  "java.format.comments.enabled": true,
  "java.format.onType.enabled": true,
  "snippets.extends": {
    "jet": [
      "html"
    ],
    "tmpl": [
      "html"
    ],
    "gohtmltmpl": [
      "html"
    ]
  },
  "snippets.ultisnips.pythonPrompt": false,
  "coc.preferences.extensionUpdateCheck": "never",
  "tsserver.log": "verbose",
  "tsserver.pluginPaths": ["."]
}
